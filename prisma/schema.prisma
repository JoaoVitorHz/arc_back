// Modelo de dados do ArcDesk (MVP)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Escritórios e usuários ----------
// Cada escritório só enxerga os próprios dados (multi-tenant por escritorioId)

model Escritorio {
  id           Int      @id @default(autoincrement())
  nome         String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  // Encerrado pelo administrador: ninguém acessa e os dados podem ser restaurados por
  // quem encerrou em até 30 dias (a exclusão definitiva ainda não é automática)
  encerradoEm    DateTime?
  encerradoPorId Int?
  encerradoPor   Usuario?  @relation("EscritoriosEncerrados", fields: [encerradoPorId], references: [id], onDelete: SetNull)

  usuarios    Usuario[]    @relation("MembrosDoEscritorio")
  convites    Convite[]
  clientes    Cliente[]
  projetos    Projeto[]
  eventos     Evento[]
  tiposEvento TipoEvento[]
  lancamentos Lancamento[]
  arquivos    Arquivo[]

  @@index([encerradoPorId])
  @@map("escritorios")
}

enum PapelUsuario {
  ADMIN // gerencia a equipe e o escritório
  MEMBRO // usa o sistema normalmente
}

model Usuario {
  id                Int          @id @default(autoincrement())
  nome              String
  email             String       @unique
  senhaHash         String
  papel             PapelUsuario @default(ADMIN)
  // Membro que pode ver o financeiro (lançamentos e valores de contrato). Administradores sempre veem.
  // Volta a "não" quando a pessoa sai ou entra em outro escritório.
  verFinanceiro     Boolean      @default(false)
  // Conta criada pelo administrador com senha provisória: precisa criar a própria senha ao entrar
  deveTrocarSenha   Boolean      @default(false)
  // Tokens de login emitidos antes desta data deixam de valer (preenchido ao trocar a senha)
  tokensValidosApos DateTime?
  criadoEm          DateTime     @default(now())
  atualizadoEm      DateTime     @updatedAt

  // Vazio = a pessoa não faz parte de nenhum escritório (saiu, foi removida ou encerrou o dela)
  escritorioId Int?
  escritorio   Escritorio? @relation("MembrosDoEscritorio", fields: [escritorioId], references: [id], onDelete: SetNull)

  tokensRedefinicao     TokenRedefinicaoSenha[]
  convitesEnviados      Convite[]               @relation("ConvitesEnviados")
  escritoriosEncerrados Escritorio[]            @relation("EscritoriosEncerrados")
  arquivosEnviados      Arquivo[]
  etapasEditadas        Etapa[]                 @relation("AnotacaoEditadaPor")
  etapasResponsavel     Etapa[]                 @relation("ResponsavelDaEtapa")
  revisoesEnviadas      RevisaoEtapa[]          @relation("RevisaoEnviadaPor")
  revisoesComPedido     RevisaoEtapa[]          @relation("RevisaoPedidoPor")
  revisoesAprovadas     RevisaoEtapa[]          @relation("RevisaoAprovadaPor")

  @@index([escritorioId])
  @@map("usuarios")
}

// Convite para entrar num escritório. Como na redefinição de senha, guardamos só o hash
// do token do link. Vale por 7 dias e só uma vez.
model Convite {
  id        Int          @id @default(autoincrement())
  nome      String
  email     String
  papel     PapelUsuario @default(MEMBRO)
  tokenHash String       @unique
  expiraEm  DateTime
  aceitoEm  DateTime?
  criadoEm  DateTime     @default(now())

  escritorioId   Int
  escritorio     Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  convidadoPorId Int?
  convidadoPor   Usuario?   @relation("ConvitesEnviados", fields: [convidadoPorId], references: [id], onDelete: SetNull)

  @@index([escritorioId])
  @@index([email])
  @@index([convidadoPorId])
  @@map("convites")
}

// Links de "esqueci minha senha". Guardamos só o hash do token: quem ler o banco
// não consegue usar o link. Vale por 1 hora e só uma vez.
model TokenRedefinicaoSenha {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("tokens_redefinicao_senha")
}

// ---------- Clientes ----------

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String?
  telefone     String?
  documento    String? // CPF ou CNPJ
  endereco     String?
  observacoes  String?  @db.Text
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  projetos Projeto[]
  eventos  Evento[]

  @@index([escritorioId])
  @@map("clientes")
}

// ---------- Projetos e etapas ----------

enum TipoProjeto {
  RESIDENCIAL
  INTERIORES
  COMERCIAL
  OUTRO
}

enum StatusProjeto {
  ATIVO
  PAUSADO
  CONCLUIDO
}

model Projeto {
  id              Int           @id @default(autoincrement())
  nome            String
  tipo            TipoProjeto   @default(RESIDENCIAL)
  status          StatusProjeto @default(ATIVO)
  enderecoObra    String?
  valorContrato   Decimal?      @db.Decimal(12, 2)
  dataInicio      DateTime?     @db.Date
  previsaoEntrega DateTime?     @db.Date
  observacoes     String?       @db.Text
  // Projeto criado pelo "Novo projeto com IA": briefing original, resumo, programa de necessidades,
  // documentos a pedir ao cliente (com o que já chegou) e a proposta. Fora das consultas por padrão
  // (omit em lib/prisma.js); só a página do projeto pede.
  briefing        Json?
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  etapas      Etapa[]
  eventos     Evento[]
  lancamentos Lancamento[]
  arquivos    Arquivo[]

  @@index([escritorioId])
  @@index([clienteId])
  @@map("projetos")
}

enum StatusEtapa {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
}

model Etapa {
  id                    Int         @id @default(autoincrement())
  nome                  String
  ordem                 Int
  status                StatusEtapa @default(NAO_INICIADA)
  dataPrevista          DateTime?   @db.Date
  // Anotações livres da etapa (avisos e lembretes para a equipe); qualquer membro edita
  descricao             String?     @db.Text
  descricaoEditadaEm    DateTime?
  descricaoEditadaPorId Int?
  descricaoEditadaPor   Usuario?    @relation("AnotacaoEditadaPor", fields: [descricaoEditadaPorId], references: [id], onDelete: SetNull)

  // Pessoa da equipe que cuida da etapa (vazio = sem responsável)
  responsavelId Int?
  responsavel   Usuario? @relation("ResponsavelDaEtapa", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  // Revisões com o cliente (opcional): número da revisão em andamento (R00, R01...) e quantas o contrato prevê
  revisaoAtual      Int  @default(0)
  revisoesPrevistas Int?

  projetoId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  arquivos Arquivo[]
  revisoes RevisaoEtapa[]

  @@index([projetoId])
  @@index([descricaoEditadaPorId])
  @@index([responsavelId])
  @@map("etapas")
}

// Rodada de revisão de uma etapa (R00 = entrega original, R01 = primeira alteração...).
// Opcional: só é criada quando alguém marca a revisão como enviada ao cliente.
enum MeioEnvio {
  WHATSAPP
  EMAIL
  REUNIAO
  OUTRO
}

model RevisaoEtapa {
  id                  Int        @id @default(autoincrement())
  numero              Int
  enviadaEm           DateTime?  @db.Date
  meioEnvio           MeioEnvio?
  observacaoEnvio     String?    @db.Text
  pedidoAlteracao     String?    @db.Text // o que o cliente pediu para mudar
  pedidoEm            DateTime?  @db.Date
  aprovadaEm          DateTime?  @db.Date
  observacaoAprovacao String?    @db.Text
  criadoEm            DateTime   @default(now())
  atualizadoEm        DateTime   @updatedAt

  etapaId       Int
  etapa         Etapa    @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  enviadaPorId  Int?
  enviadaPor    Usuario? @relation("RevisaoEnviadaPor", fields: [enviadaPorId], references: [id], onDelete: SetNull)
  pedidoPorId   Int?
  pedidoPor     Usuario? @relation("RevisaoPedidoPor", fields: [pedidoPorId], references: [id], onDelete: SetNull)
  aprovadaPorId Int?
  aprovadaPor   Usuario? @relation("RevisaoAprovadaPor", fields: [aprovadaPorId], references: [id], onDelete: SetNull)

  @@unique([etapaId, numero])
  @@index([enviadaPorId])
  @@index([pedidoPorId])
  @@index([aprovadaPorId])
  @@map("revisoes_etapa")
}

// ---------- Arquivos dos projetos ----------

enum TipoArquivo {
  ARQUIVO // enviado para o sistema (guardado no armazenamento)
  LINK // endereço externo (Google Drive, Dropbox, WeTransfer...)
}

// Arquivo ou link anexado a um projeto, dentro de uma etapa ou na pasta "Geral do projeto" (etapaId vazio).
// Apagar a etapa ou o projeto apaga os arquivos junto (as rotas também removem do armazenamento).
model Arquivo {
  id            Int         @id @default(autoincrement())
  tipo          TipoArquivo @default(ARQUIVO)
  nome          String // nome mostrado (o original do computador, ou o título do link)
  mimeType      String?
  tamanho       Int? // bytes
  chave         String? // onde está no armazenamento (só ARQUIVO)
  url           String?     @db.Text // só LINK
  revisaoNumero Int         @default(0) // revisão da etapa em que o arquivo foi anexado (R00, R01...)
  criadoEm      DateTime    @default(now())

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)
  projetoId    Int
  projeto      Projeto    @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  etapaId      Int?
  etapa        Etapa?     @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  enviadoPorId Int?
  enviadoPor   Usuario?   @relation(fields: [enviadoPorId], references: [id], onDelete: SetNull)

  @@index([escritorioId])
  @@index([projetoId])
  @@index([etapaId])
  @@index([enviadoPorId])
  @@map("arquivos")
}

// ---------- Agenda ----------

// Tipos de compromisso cadastrados por cada escritório (Reunião, Visita de obra...)
model TipoEvento {
  id           Int      @id @default(autoincrement())
  nome         String
  cor          String   @default("blue") // chave da paleta: blue, purple, pink, red, orange, amber, green, gray
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  eventos Evento[]

  @@unique([escritorioId, nome])
  @@map("tipos_evento")
}

model Evento {
  id           Int       @id @default(autoincrement())
  titulo       String
  inicio       DateTime
  fim          DateTime?
  local        String?
  descricao    String?   @db.Text
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  // Ao excluir um tipo, os compromissos dele ficam sem tipo
  tipoId Int?
  tipo   TipoEvento? @relation(fields: [tipoId], references: [id], onDelete: SetNull)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([tipoId])
  @@index([escritorioId, inicio])
  @@index([inicio])
  @@map("eventos")
}

// ---------- Financeiro ----------

enum TipoLancamento {
  RECEITA
  DESPESA
}

model Lancamento {
  id            Int            @id @default(autoincrement())
  descricao     String
  tipo          TipoLancamento
  valor         Decimal        @db.Decimal(12, 2)
  vencimento    DateTime       @db.Date
  pago          Boolean        @default(false)
  dataPagamento DateTime?      @db.Date
  categoria     String?
  // Lançamentos criados juntos (parcelas ou "todo mês") têm o mesmo serieId,
  // para editar ou excluir "este e os próximos"
  serieId       String?        @db.VarChar(36)
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([escritorioId, vencimento])
  @@index([vencimento])
  @@index([serieId])
  @@map("lancamentos")
}
