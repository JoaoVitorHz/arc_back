// Modelo de dados do ArcGestão (MVP)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Escritórios e usuários ----------
// Cada escritório só enxerga os próprios dados (multi-tenant por escritorioId)

model Escritorio {
  id           Int      @id @default(autoincrement())
  nome         String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarios    Usuario[]
  clientes    Cliente[]
  projetos    Projeto[]
  eventos     Evento[]
  tiposEvento TipoEvento[]
  lancamentos Lancamento[]

  @@map("escritorios")
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String   @unique
  senhaHash    String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  @@index([escritorioId])
  @@map("usuarios")
}

// ---------- Clientes ----------

model Cliente {
  id           Int      @id @default(autoincrement())
  nome         String
  email        String?
  telefone     String?
  documento    String? // CPF ou CNPJ
  endereco     String?
  observacoes  String?  @db.Text
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  projetos Projeto[]
  eventos  Evento[]

  @@index([escritorioId])
  @@map("clientes")
}

// ---------- Projetos e etapas ----------

enum TipoProjeto {
  RESIDENCIAL
  INTERIORES
  COMERCIAL
  OUTRO
}

enum StatusProjeto {
  ATIVO
  PAUSADO
  CONCLUIDO
}

model Projeto {
  id              Int           @id @default(autoincrement())
  nome            String
  tipo            TipoProjeto   @default(RESIDENCIAL)
  status          StatusProjeto @default(ATIVO)
  enderecoObra    String?
  valorContrato   Decimal?      @db.Decimal(12, 2)
  dataInicio      DateTime?     @db.Date
  previsaoEntrega DateTime?     @db.Date
  observacoes     String?       @db.Text
  criadoEm        DateTime      @default(now())
  atualizadoEm    DateTime      @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  etapas      Etapa[]
  eventos     Evento[]
  lancamentos Lancamento[]

  @@index([escritorioId])
  @@index([clienteId])
  @@map("projetos")
}

enum StatusEtapa {
  NAO_INICIADA
  EM_ANDAMENTO
  CONCLUIDA
}

model Etapa {
  id           Int         @id @default(autoincrement())
  nome         String
  ordem        Int
  status       StatusEtapa @default(NAO_INICIADA)
  dataPrevista DateTime?   @db.Date
  criadoEm     DateTime    @default(now())
  atualizadoEm DateTime    @updatedAt

  projetoId Int
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@index([projetoId])
  @@map("etapas")
}

// ---------- Agenda ----------

// Tipos de compromisso cadastrados por cada escritório (Reunião, Visita de obra...)
model TipoEvento {
  id           Int      @id @default(autoincrement())
  nome         String
  cor          String   @default("blue") // chave da paleta: blue, purple, pink, red, orange, amber, green, gray
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  eventos Evento[]

  @@unique([escritorioId, nome])
  @@map("tipos_evento")
}

model Evento {
  id           Int       @id @default(autoincrement())
  titulo       String
  inicio       DateTime
  fim          DateTime?
  local        String?
  descricao    String?   @db.Text
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  // Ao excluir um tipo, os compromissos dele ficam sem tipo
  tipoId Int?
  tipo   TipoEvento? @relation(fields: [tipoId], references: [id], onDelete: SetNull)

  clienteId Int?
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([tipoId])
  @@index([escritorioId, inicio])
  @@index([inicio])
  @@map("eventos")
}

// ---------- Financeiro ----------

enum TipoLancamento {
  RECEITA
  DESPESA
}

model Lancamento {
  id            Int            @id @default(autoincrement())
  descricao     String
  tipo          TipoLancamento
  valor         Decimal        @db.Decimal(12, 2)
  vencimento    DateTime       @db.Date
  pago          Boolean        @default(false)
  dataPagamento DateTime?      @db.Date
  categoria     String?
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  escritorioId Int
  escritorio   Escritorio @relation(fields: [escritorioId], references: [id], onDelete: Cascade)

  projetoId Int?
  projeto   Projeto? @relation(fields: [projetoId], references: [id], onDelete: SetNull)

  @@index([escritorioId, vencimento])
  @@index([vencimento])
  @@map("lancamentos")
}
