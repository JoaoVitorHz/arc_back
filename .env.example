# Copie este arquivo para .env e ajuste os valores
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/arcgestao"
PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Segredo que assina os tokens de login. Gere um valor aleatório com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio"

# Endereço do frontend, usado nos links enviados por e-mail (ex.: redefinir senha)
APP_URL="http://localhost:3000"

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são mostrados no terminal da API em vez de enviados.
# Exemplo com Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER=seu@gmail.com
# e SMTP_PASS = uma "senha de app" (https://myaccount.google.com/apppasswords)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ArcGestão <nao-responda@seudominio.com>"

# Pasta onde ficam os arquivos enviados nos projetos (padrão: ArcBack/uploads)
# UPLOAD_DIR="C:/ArcGestao/uploads"

# Inteligência artificial (OpenAI). Sem a chave, os recursos de IA ficam escondidos.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5.4-mini"
# Voz do assistente
# OPENAI_VOZ="marin"
# OPENAI_MODELO_VOZ="gpt-4o-mini-tts"
