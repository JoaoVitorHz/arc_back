# Copie este arquivo para .env e ajuste os valores
DATABASE_URL="mysql://USUARIO:SENHA@localhost:3306/arcgestao"
PORT=3333
CORS_ORIGIN="http://localhost:3000"

# Segredo que assina os tokens de login. Gere um valor aleatório com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="troque-por-um-valor-aleatorio"

# Endereço do frontend, usado nos links enviados por e-mail (ex.: redefinir senha)
APP_URL="http://localhost:3000"

# E-mail (SMTP). Sem SMTP_HOST, os e-mails são mostrados no terminal da API em vez de enviados.
# Exemplo com Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_USER=seu@gmail.com
# e SMTP_PASS = uma "senha de app" (https://myaccount.google.com/apppasswords)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ArcDesk <nao-responda@seudominio.com>"

# Pasta onde ficam os arquivos enviados nos projetos (padrão: ArcBack/uploads)
# UPLOAD_DIR="C:/ArcDesk/uploads"

# Inteligência artificial (OpenAI). Sem a chave, os recursos de IA ficam escondidos.
OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-5.4-mini"
# Voz do assistente
# OPENAI_VOZ="marin"
# OPENAI_MODELO_VOZ="gpt-4o-mini-tts"
# OPENAI_MODELO_TRANSCRICAO="gpt-4o-mini-transcribe"

# Assinatura do ArcDesk (gateway Asaas). Sem ASAAS_API_KEY, a tela de assinatura avisa que a
# cobrança não está ativa. A chave do sandbox começa com $aact_hmlg_ e a de produção com $aact_prod_.
ASAAS_API_KEY=""
# sandbox | producao
ASAAS_AMBIENTE="sandbox"
# Token que o Asaas manda nos avisos (webhooks). Gere um valor aleatório (32+ caracteres) e use
# o mesmo no painel do Asaas, em Integrações > Webhooks, com a URL https://SUA-API/api/webhooks/asaas
ASAAS_WEBHOOK_TOKEN=""

# Nota fiscal automática a cada pagamento (deixe false para emitir manualmente)
ASAAS_EMITIR_NOTA=false
# Códigos passados pela contabilidade (confira no painel do Asaas antes de ligar)
# ASAAS_NOTA_CODIGO_SERVICO="1.07"
# ASAAS_NOTA_DESCRICAO="Suporte técnico, manutenção e disponibilização da plataforma ArcDesk"
# ASAAS_NOTA_NBS="115080000"
# ASAAS_NOTA_ISS=0

# Bloquear o acesso de quem passou do teste grátis sem pagar (false enquanto testa)
ASSINATURA_OBRIGATORIA=false
# ASSINATURA_DIAS_TESTE=14
# ASSINATURA_DIAS_TOLERANCIA=7
# Preço de teste para cobrar um valor baixo em produção (apague depois do teste)
# ASSINATURA_VALOR_TESTE=5

# Em produção atrás do Nginx, para a API enxergar o IP real de quem acessa
# TRUST_PROXY=1
